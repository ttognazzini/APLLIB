Create or Replace Trigger APLLIB.FLEFLDTRG
before Insert or Update on APLLIB.FLEFLD
Referencing new row as n old row as o
for each row mode db2row

Begin
  /* On create set the crtXXX values */
  If Inserting Then
    set n.create_time_stamp = current timestamp,
        n.create_user = user,
        n.create_job = job_name,
        n.create_program = APLLIB.current_program();
  End If ;


  /* On create, or update and a field changes, set the mntXXX values */
  If inserting or
     (updating and (
        n.active_row <> o.active_row
       or n.file_field_id <> o.file_field_id
       or n.file_library <> o.file_library
       or n.file_name <> o.file_name
       or n.field_name <> o.field_name
       or n.field_sequence <> o.field_sequence
       or n.field_level <> o.field_level
       or n.field_status <> o.field_status
       or n.file_id <> o.file_id
       or n.primary_key <> o.primary_key
       or n.auit_field <> o.auit_field
       or n.encrypt_field <> o.encrypt_field
       or n.note_exists <> o.note_exists
       or n.starting_id <> o.starting_id
       or n.id_increment <> o.id_increment
  )) Then
    set n.maintenance_time_stamp = current timestamp,
        n.maintenance_user = user,
        n.maintenance_job = job_name,
        n.maintenance_program = APLLIB.current_program();
  End If;

  /* Add all audited columns */

  /* Trim all varchar columns */

End
