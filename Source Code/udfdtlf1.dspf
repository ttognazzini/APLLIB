     A                                      CF23
     A                                      CF24
     A                                      RTNCSRLOC(*WINDOW &CSRROW &CSRCOL)
     A                                      RTNCSRLOC(&CSRRCD &CSRFLD &CSRPOS)
     A                                      CSRLOC(OUTROW     OUTCOL)
     A                                      OVERLAY
     A                                      SFLCSRRRN(&CSRRRN1)
     A  51                                  SFLDSP
     A N50                                  SFLDSPCTL
     A  50                                  SFLCLR
     A N98                                  SFLEND
     A                                      SFLSIZ(&SFLSIZ)
     A                                      SFLPAG(0012)
     A            OUTRRN1        4S 0H      SFLRCDNBR
     A            OUTROW         3S 0H
     A            OUTCOL         3S 0H
     A            CSRRRN1        5S 0H
     A            CSRRCD        10A  H
     A            CSRFLD        10A  H
     A            CSRPOS         4S 0H
     A            CSRROW         3S 0H
     A            CSRCOL         3S 0H
     A            SFLSIZ         5S 0P
     A            SFLMODE        1A  H
     A            FLTEFF         1A  H
     A            SEL1@          1A  P
     A            PGMNME1@       1A  P
     A            PGMDES1@       1A  P
     A                                  1  2DATE
     A                                      EDTWRD('0  /  /  ')
     A                                  1 11TIME
     A                                      EDTWRD(' 0:  :  ')
     A            ENVIRONMNT    40A  O  1 21MSGID(AAA 0000 ENVIRONMNT)
     A            PGMNMEH   R        O  1 70REFFLD(PGMNME)
     A                                      ALIAS(PROGRAM_NAME_H)
     A            MDE       R        O  2  2
     A                                  2 22'User Defaults Detail Program Selec-
     A                                      tion'
     A                                      COLOR(WHT)
     A                                  2 70USER
     A                                  4  1'Search:'
     A            SCHVAL    R        B  4  9
     A            OPTIONS       79A  O  6  1COLOR(BLU)
     A                                  8  1'Sel'
     A                                      DSPATR(UL)
     A                                      COLOR(WHT)
     A                                  8  5'Program   '
     A                                      DSPATR(HI)
     A                                      DSPATR(UL)
     A                                  8 16'Description                       -
     A                                                                '
     A                                      DSPATR(HI)
     A                                      DSPATR(UL)
     A            SEL1      R        B  9  2REFFLD(OPTION)
     A                                      DSPATR(&SEL1@)
     A            PGMNME1   R        B  9  5REFFLD(PGMNME)
     A                                      DSPATR(&PGMNME1@)
     A            PGMDES1   R        B  9 16REFFLD(PGMDES)
     A                                      DSPATR(&PGMDES1@)
     A                                      CHECK(LC)
