     A*                                     Start automated help text informatio
     A          H                           HLPPNLGRP(USRMSTD8 USRMSTP8)
     A                                      HLPARA(01 001 01 001)
     A          H                           HLPPNLGRP('ENVIRONMNT' USRMSTP8)
     A                                      HLPARA(*FLD ENVIRONMNT)
     A          H                           HLPPNLGRP('PGMNME' USRMSTP8)
     A                                      HLPARA(*FLD PGMNME)
     A          H                           HLPPNLGRP('MDE' USRMSTP8)
     A                                      HLPARA(*FLD MDE)
     A          H                           HLPPNLGRP('ACNO' USRMSTP8)
     A                                      HLPARA(*FLD ACNO)
