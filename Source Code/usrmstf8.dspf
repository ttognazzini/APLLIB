     A*                                     End Automated help text information
     A            OUTROWSCR      3S 0H
     A            OUTCOLSCR      3S 0H
     A            CSRRCD        10A  H
     A            CSRFLD        10A  H
     A            CSRPOS         4S 0H
     A            CSRROW         3S 0H
     A            CSRCOL         3S 0H
     A            FST3@          1A  P
     A                                  1  2DATE
     A                                      EDTWRD('0  /  /  ')
     A                                  1 11TIME
     A                                      EDTWRD(' 0:  :  ')
     A            ENVIRONMNT    40A  O  1 21MSGID(AAA 0000 ENVIRONMNT)
     A            PGMNME        10A  O  1 70
     A            MDE           10A  O  2  2
     A                                  2 29'User Master Maintenance'
     A                                      COLOR(WHT)
     A                                  2 70USER
     A                                  3 27'Create Developer Environment'
     A                                      DSPATR(HI)
     A                                  5  2'User Number'
     A            ACNO      R        O  5 21REFFLD(ACNO APLDCT)
     A                                      EDTCDE(Z)
     A            USRNME    R        O  5 28REFFLD(USRNME APLDCT)
     A                                  7  2'First 3 Letters'
     A            FST3      R        B  7 21REFFLD(OPR)
     A                                      DSPATR(&FST3@)
     A                                  7 32'First 3 letters of their library --
     A                                       calls CLP472'
     A                                  9 32'First 3 letters of their first nam-
     A                                      e if not used'
     A                                 10 32'else the first 3 letters of their -
     A                                      last name if'
     A                                 11 32'not used. If blanks, manually assi-
     A                                      gn the first'
     A                                 12 32'3 letters of their development lib-
     A                                      rary.'
     A            FNCKEYS       79A  O 23  2COLOR(BLU)
