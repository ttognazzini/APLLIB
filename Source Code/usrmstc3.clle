/* User Master Maintenance - Copy User Profile details */

/****** COMPILE AS QSECOFR OR CHANGE THE OWNER ******/
/* CHGPGM PGM(USRMSTC3) USRPRF(*OWNER) USEADPAUT(*YES)     */
/* CHGOBJOWN OBJ(USRMSTC3) OBJTYPE(*PGM)  NEWOWN(QSECOFR)  */

PGM (&USRPRF &CPYUSR &ACGCDE &USRNME &USROQN &USROQL &GRPPRF)

  DCL &USRPRF *CHAR 10
  DCL &CPYUSR *CHAR 10
  DCL &ACGCDE *CHAR 15
  DCL &USRNME *CHAR 50
  DCL &USROQN *CHAR 10
  DCL &USROQL *CHAR 10
  DCL &GRPPRF *CHAR 10

  /* WORK VARIABLES */
  DCL &ACGCDEF *CHAR 15
  DCL &SYSNAME *CHAR 10
  DCL &DEPT    *CHAR 10
  DCL &USERNAM *CHAR 30

  /* THIS COMMAND NEEDS THE 15 CHARACTER ACCOUNTING CODE, FABRICUT ONLY USES THE FIRST 6 +
     SO THIS CODE MOVES THE FIRST 6 INTO A FULL 15 CHARACTER VARIABLE */
  CHGVAR &ACGCDEF &ACGCDE

  /* THE CHGUSRPRF COMMAND WILL BLOW UP WITH BLANK VALUES, THEY EITHER NEED TO BE SET TO *NONE OR *BLANK */
  IF (&ACGCDEF *EQ ' ') (CHGVAR  &ACGCDEF VALUE('*BLANK'))
  IF (&GRPPRF  *EQ ' ') (CHGVAR  &GRPPRF  VALUE('*NONE'))

  /* IF A DEFAULT IS USED FOR THE OUTPUT QUEUE THE LIBRARY CANNOT BE PASSED SO WE HAVE TO USE DIFFERENT COMMANDS */
  IF (&USROQN *EQ '*WRKSTN' *OR &USROQN *EQ '*DEV') +
       SBMJOB CMD(CRTUSRPRF USRPRF(&USRPRF) INLPGM(APLLIB/GPJINIT) INLMNU(*SIGNOFF) LMTCPB(*YES) TEXT(&USRNME) +
          SPCAUT(*NONE) GRPPRF(&GRPPRF) ACGCDE(&ACGCDE) DLVRY(*BREAK) OUTQ(&USROQN) ATNPGM(APLLIB/GPJATTN)) +
          JOB(CRTPRF) JOBQ(QUSRNOMAX) USER(JICOFR)
  ELSE SBMJOB CMD(CRTUSRPRF USRPRF(&USRPrf) INLPGM(APLLIB/GPJINIT) INLMNU(*SIGNOFF) LMTCPB(*YES) TEXT(&USRNME) +
          SPCAUT(*NONE) GRPPRF(&GRPPRF) ACGCDE(&ACGCDE) DLVRY(*BREAK) OUTQ(&USROQL/&USROQN) ATNPGM(APLLIB/GPJATTN)) +
          JOB(CRTPRF) JOBQ(QUSRNOMAX) USER(JICOFR)

  /* CHANGE THE USER ON PROD 2 AND 3 FOR MIS */
  RTVNETA    SYSNAME(&SYSNAME)
  IF (&SYSNAME *EQ 'FABRICUT') DO
    CALL GPRNAMUP (&USRPRF &USERNAM &DEPT)
    IF (&DEPT *EQ 'MIS') DO /* NEXT COMMANDS QUALIFIED SO CL WILL COMPILE */
      RBTHALIB/RUNCMDRSF CMD(CALL APLLIB/CLP285S3 ('A' 'N' &USRPRF &CPYUSR &USRNME &GRPPRF &ACGCDEF &USROQN &USROQL)) +
                         SERVER(PROD3)
      MONMSG (CPF0000 RSF0000)
      RBTHALIB/RUNCMDRSF CMD(CALL APLLIB/CLP285S2 ('A' 'N' &USRPRF &CPYUSR &USRNME &GRPPRF &ACGCDEF &USROQN &USROQL)) +
                         SERVER(PROD2)
      MONMSG (CPF0000 RSF0000)
    ENDDO
  ENDDO

  /* ATTEMP TO CREATE AN OUTPUT QUEUE FOR THE USER PROFILE IN QGPL. THIS IS USED BY THE FASTFAX MONITOR */
  CRTOUTQ OUTQ(QGPL/&USRPRF)
  MONMSG CPF0000

ENDPGM
