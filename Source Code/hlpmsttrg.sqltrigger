/************************************************************************/
/* This source code was auto created via the APLLIB/FLEMST command. Do  */
/* not manually update this or it will get overlaid if generated again. */
/************************************************************************/

Create or Replace Trigger APLLIB.HLPMSTTRG
before Insert or Update on APLLIB.HLPMST
Referencing new row as n old row as o
for each row mode db2row

Begin
  /* On create set the crtXXX values */
  If Inserting Then
    set n.create_time_stamp = current timestamp,
        n.create_user = user,
        n.create_job = job_name,
        n.create_program = APLLIB.current_program();
  End If ;


  /* On create, or update and a field changes, set the mntXXX values */
  If inserting or
     (updating and (
        n.active_row <> o.active_row
       or n.help_master_id <> o.help_master_id
       or n.dictionary_name <> o.dictionary_name
       or n.field_name <> o.field_name
       or n.display_file <> o.display_file
       or n.value_ <> o.value_
       or n.help_type <> o.help_type
       or n.line_count <> o.line_count
       or n.description <> o.description
       or n.help_reference <> o.help_reference
  )) Then
    set n.maintenance_time_stamp = current timestamp,
        n.maintenance_user = user,
        n.maintenance_job = job_name,
        n.maintenance_program = APLLIB.current_program();
  End If;

  /* Add all audited columns */

  If o.help_reference <>  n.help_reference Then
    Insert into APLLIB.AUDLOG
          (fleLib, fleNme, fleMstIdn,
           rcdIdn, fldNme, fleFldIdn,
           bfrVal, aftVal)
    Values('APLLIB','HLPMST', 18,
           n.help_master_id,'HLPREF',421,
           o.help_reference, n.help_reference);
  End If;

  /* Trim all varchar columns */

End
