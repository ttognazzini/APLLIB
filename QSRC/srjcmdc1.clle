/* COMAND PROMPT OVERRIDE PROGRAM FOR SRJ     */
/* SUBMIT RESTORE JOURNAL AND BUILD WORK FILE */
/* TO A TEMP FILE IN THE PROGRAMMERS TEMP LIB */

PGM (&CMDNAME &PFILE_LIB &CMD_PARMS)

   DCL &CMDNAME   *CHAR LEN(20)
   DCL &PFILE_LIB *CHAR LEN(20)
     DCL &PFILE   *CHAR LEN(10)  STG(*DEFINED) DEFVAR(&PFILE_LIB)
     DCL &PLIB    *CHAR LEN(10)  STG(*DEFINED) DEFVAR(&PFILE_LIB 11)
   DCL &CMD_PARMS *CHAR LEN(502)
     DCL &LEN_PMS *INT  LEN(2)   STG(*DEFINED) DEFVAR(&CMD_PARMS)
     DCL &PARMS   *CHAR LEN(500) STG(*DEFINED) DEFVAR(&CMD_PARMS 3)

   DCL &WFILE     *CHAR LEN(10)
   DCL &WLIB      *CHAR LEN(10)
   DCL &VALUE     *CHAR LEN(128)
   DCL &USER      *CHAR LEN(10)
   DCL &JOBNAME   *CHAR LEN(10)

/* Get programmers dev library, same as user profile */
   RTVJOBA USER(&WLIB)

/* TRY TO DEFAULT THE FILE NAME, IF IT ENDS IN PF REPLACE PF WITH RJ */
/* OTHERWISE TRY APPENDING RJ TO THE END, OTHERWISE OVERLAY RJ AT END */
   IF (%SST(&PFILE 9 2) *EQ 'PF') ( +
      CHGVAR &WFILE (%SST(&PFILE 1 8) *CAT 'RJ') )
   ELSE IF (%SST(&PFILE 8 3) *EQ 'PF ') ( +
      CHGVAR &WFILE (%SST(&PFILE 1 7) *CAT 'RJ') )
   ELSE IF (%SST(&PFILE 7 4) *EQ 'PF  ') ( +
      CHGVAR &WFILE (%SST(&PFILE 1 6) *CAT 'RJ') )
   ELSE IF (%SST(&PFILE 6 5) *EQ 'PF   ') ( +
      CHGVAR &WFILE (%SST(&PFILE 1 5) *CAT 'RJ') )
   ELSE IF (%SST(&PFILE 5 6) *EQ 'PF    ') ( +
      CHGVAR &WFILE (%SST(&PFILE 1 4) *CAT 'RJ') )
   ELSE IF (%SST(&PFILE 9 2) *EQ '  ') ( +
      CHGVAR &WFILE (&PFILE *TCAT 'RJ') )
   ELSE CHGVAR &WFILE (%SST(&PFILE 1 8) *CAT 'RJ')

/* if there is no library or *LIBL, find the library */
  IF (&PLIB *EQ ' ' *OR &PLIB *EQ '*LIBL') (DO)
    RTVOBJD OBJ(&PFILE) OBJTYPE(*FILE) RTNLIB(&PLIB)
    MONMSG CPF0000
  ENDDO

/* SEND DEFAULTS BACK TO PROGRAM */
   CHGVAR &PARMS +
            ('??OUTFILE(' *CAT &WLIB *TCAT '/' *CAT &WFILE *TCAT ')' +
       *BCAT '??JOBNAME(SRJ_' *CAT %SST(&PFILE 1 6) *TCAT ')' +
       *BCAT '??FROMDATE(5)' )

/* SET THE LENGTH OF THE OUTPUT PARMS */
/* THE STRUCTURE DEFINED FOR CMD_PARMS BASICALLY MAKES THIS A */
/* A VARIBLE LENGTH FIELD */
   CHGVAR VAR(&LEN_PMS) VALUE(500)

        ENDPGM
