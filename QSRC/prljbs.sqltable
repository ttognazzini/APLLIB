/* Performace Logger - Job Statistics Log */

Create or Replace Table APLLIB.job_status_info_log for System Name PRLJBS (
  active_row                        for Column ACVROW    char(1) Not Null Default '1',
  job_statistic_log_id              for Column prlJbsIdn bigint Not Null
                                    Generated Always as Identity (Start With 1 Increment by 1),
  system_statistic_log_id           for Column prlSstIdn bigint,

  job_name                          varchar(28),
  job_name_short                    varchar(10),
  job_user                          varchar(10),
  job_number                        varchar(6),
  internal_job_id                   binary(16),
  subsystem                         varchar(10),
  subsystem_library_name            varchar(10),
  authorization_name                varchar(10),
  job_type                          varchar(3),
  function_type                     varchar(3),
  function_name                     varchar(10),
  job_status                        varchar(4),
  memory_pool                       varchar(9),
  run_priority                      int,
  thread_count                      int,
  temporary_storage                 int,
  cpu_time                          decimal(20,0),
  total_disk_io_count               decimal(20,0),
  elapsed_time                      decimal(20,3),
  elapsed_interaction_count         int,
  elapsed_total_response_time       int,
  elapsed_total_disk_io_count       decimal(20,0),
  elapsed_async_disk_io_count       decimal(20,0),
  elapsed_sync_disk_io_count        decimal(20,0),
  elapsed_cpu_percentage            decimal(10,2),
  elapsed_cpu_time                  decimal(20,0),
  elapsed_page_fault_count          decimal(20,0),
  server_type                       varchar(30),
  job_description_library           varchar(10),
  job_description                   varchar(10),
  job_queue_library                 varchar(10),
  job_queue                         varchar(10),
  sort_sequence_library             varchar(10),
  sort_sequence                     varchar(10),
  job_type_enhanced                 varchar(28),
  job_entered_system_time           timestamp(0),
  job_active_time                   timestamp(0),
  client_ip_address                 varchar(45),
  job_user_identity_setting         varchar(11),
  job_user_identity                 varchar(10),
  signal_status                     varchar(3),
  message_reply                     varchar(3),
  maximum_active_threads            int,
  system_pool_id                    int,
  pool_name                         varchar(10),
  qtemp_size                        int,
  peak_temporary_storage            int,
  default_wait                      int,
  maximum_processing_time_allowed   int,
  maximum_temporary_storage_allowed int,
  time_slice                        int,
  page_faults                       bigint,
  total_response_time               bigint,
  interactive_transactions          int,
  database_lock_waits               int,
  non_database_lock_waits           int,
  internal_machine_lock_waits       int,
  database_lock_wait_time           int,
  non_database_lock_wait_time       int,
  internal_machine_lock_wait_time   int,
  sql_statement_text                varchar(10000),
  sql_statement_status              varchar(8),
  sql_statement_start_timestamp     timestamp,
  sql_statement_name                varchar(128),
  sql_statement_library_name        varchar(10),
  sql_statement_object_name         varchar(10),
  sql_statement_object_type         varchar(7),
  query_options_library_name        varchar(10),
  sql_activation_group_count        int,
  sql_descriptor_count              bigint,
  sql_lob_locator_count             int,
  cli_handle_count                  bigint,
  sql_server_mode                   varchar(3),
  client_acctng                     varchar(255),
  client_applname                   varchar(255),
  client_programid                  varchar(255),
  client_userid                     varchar(255),
  client_wrkstnname                 varchar(255),
  routine_type                      char(1),
  routine_schema                    varchar(128),
  routine_specific_name             varchar(128),
  client_port                       int,
  client_host                       varchar(255),
  interface_name                    varchar(127),
  interface_type                    varchar(63),
  interface_level                   varchar(63),
  server_mode_connecting_job        varchar(28),
  server_mode_connecting_thread     bigint,
  prestart_job_reuse_count          int,
  prestart_job_max_use_count        int,
  available_result_sets             int,
  unconsumed_result_sets            int,
  open_cursor_count                 int,
  full_open_cursor_count            bigint,
  pseudo_open_cursor_count          bigint,
  pseudo_closed_cursor_count        int,
  largest_query_size                int,
  open_files                        int,

  create_time_stamp                 for Column crtDtm    timestamp    Not Null Default CURRENT_TIMESTAMP,
  create_user                       for Column crtUsr    char(18)     Not Null Default USER,
  create_job                        for Column crtJob    char(28),
  create_program                    for Column crtPgm    char(10),
  maintenance_time_stamp            for Column mntDtm    timestamp    Not Null Default CURRENT_TIMESTAMP,
  maintenance_user                  for Column mntUsr    char(18)     Not Null Default USER,
  maintenance_job                   for Column mntJob    char(28),
  maintenance_program               for Column mntPgm    char(10)
);

Label on Table PRLJBS is 'Performace Logger - Job Statistics Log';

Comment on Table PRLJBS is
'This table is used to log active job statistics. It is populated in program PRLLOGB1. The data is intented to be used t
o see what jobs are taking up system resources. This data can assist with finding inefficent programs.'
;
