/* User Master Maintenance - Update User Profile details */

/****** COMPILE AS QSECOFR OR CHANGE THE OWNER ******/
/* CHGPGM PGM(USRMSTC2) USRPRF(*OWNER) USEADPAUT(*YES)     */
/* CHGOBJOWN OBJ(USRMSTC2) OBJTYPE(*PGM)  NEWOWN(QSECOFR)  */

PGM (&USRPRF &ACGCDE &USRNME &USROQN &USROQL &GRPPRF &PMSMTPUSR &PMSMTPDMN)

  /* INPUT PARAMETERS */
  DCL &USRPRF *CHAR 10
  DCL &ACGCDE *CHAR 6
  DCL &USRNME *CHAR 50
  DCL &USROQN *CHAR 10
  DCL &USROQL *CHAR 10
  DCL &GRPPRF *CHAR 10
  DCL &PMSMTPUSR *CHAR 30 /* SMPT USER */
  DCL &PMSMTPDMN *CHAR 30 /* SMPT DOMAIN */

  /* WORK VARIABLES */
  DCL &ACGCDEF *CHAR 15
  DCL &SYSNAME *CHAR 10
  DCL &DEPT    *CHAR 10
  DCL &CPYUSR  *CHAR 10
  DCL &USERNAM *CHAR 30
  DCL &USER8   *CHAR 8
  DCL &SMTPUSR *CHAR 30 /* SMPT USER */
  DCL &SMTPDMN *CHAR 30 /* SMPT DOMAIN */

  CHGVAR &SMTPUSR &PMSMTPUSR
  MONMSG MSGID(MCH3601) EXEC(CHGVAR &SMTPUSR ' ')
  CHGVAR &SMTPDMN &PMSMTPDMN
  MONMSG MSGID(MCH3601) EXEC(CHGVAR &SMTPDMN ' ')

  /* THIS COMMAND NEEDS THE 15 CHARACTER ACCOUNTING CODE, FABRICUT ONLY USES THE FIRST 6 +
     SO THIS CODE MOVES THE FIRST 6 INTO A FULL 15 CHARACTER VARIABLE */
  CHGVAR &ACGCDEF &ACGCDE

  /* THE CHGUSRPRF COMMAND WILL BLOW UP WITH BLANK VALUES, THEY EITHER NEED TO BE SET TO *NONE OR *BLANK */
  IF (&ACGCDEF *EQ ' ') (CHGVAR  &ACGCDEF VALUE('*BLANK'))
  IF (&GRPPRF  *EQ ' ') (CHGVAR  &GRPPRF  VALUE('*NONE'))
  IF (&USROQN  *EQ ' ') (CHGVAR  &USROQN  VALUE('*WRKSTN'))

  /* IF A DEFAULT IS USED FOR THE OUTPUT QUEUE THE LIBRARY CANNOT BE PASSED SO WE HAVE TO USE DIFFERENT COMMANDS */
  CHKOBJ     OBJ(&USRPRF) OBJTYPE(*USRPRF)
  MONMSG     CPF0000 EXEC(DO)
     IF         (&USROQN *EQ '*WRKSTN' *OR &USROQN *EQ '*DEV') SBMJOB CMD(CRTUSRPRF USRPRF(&USRPRF) +
                  INLPGM(APLLIB/GPJINIT) INLMNU(*SIGNOFF) LMTCPB(*YES) TEXT(&USRNME) SPCAUT(*NONE) +
                  GRPPRF(&GRPPRF) ACGCDE(&ACGCDE) DLVRY(*BREAK) OUTQ(&USROQN) ATNPGM(APLLIB/GPJATTN)) JOB(CRTPRF) +
                  JOBQ(QUSRNOMAX) USER(JICOFR) LOG(*JOBD *JOBD *NOLIST) MSGQ(*NONE)
     ELSE       SBMJOB CMD(CRTUSRPRF USRPRF(&USRPrf) INLPGM(APLLIB/GPJINIT) INLMNU(*SIGNOFF) LMTCPB(*YES) +
                  TEXT(&USRNME) SPCAUT(*NONE) GRPPRF(&GRPPRF) ACGCDE(&ACGCDE) DLVRY(*BREAK) OUTQ(&USROQL/&USROQN) +
                  ATNPGM(APLLIB/GPJATTN)) JOB(CRTPRF) JOBQ(QUSRNOMAX) USER(JICOFR) LOG(*JOBD *JOBD *NOLIST) MSGQ(*NONE)
     GOTO       TAG1
  ENDDO
  IF (%SUBSTRING(&USROQN 1 1) *EQ '*') +
       SBMJOB CMD(CHGUSRPRF USRPRF(&USRPRF) TEXT(&USRNME) GRPPRF(&GRPPRF) ACGCDE(&ACGCDE) OUTQ(&USROQN)) +
              JOB(CHGPRF) JOBQ(QUSRNOMAX) USER(JICOFR) LOG(*JOBD *JOBD *NOLIST) MSGQ(*NONE)
  ELSE SBMJOB CMD(CHGUSRPRF USRPRF(&USRPRF) TEXT(&USRNME) GRPPRF(&GRPPRF) ACGCDE(&ACGCDE) OUTQ(&USROQL/&USROQN)) +
              JOB(CHGPRF) JOBQ(QUSRNOMAX) USER(JICOFR) LOG(*JOBD *JOBD *NOLIST) MSGQ(*NONE)
 TAG1:

  /* CHANGE THE USER ON PROD 2 AND 3 FOR MIS */
  RTVNETA    SYSNAME(&SYSNAME)
  IF (&SYSNAME *EQ 'FABRICUT') DO
    CALL GPRNAMUP (&USRPRF &USERNAM &DEPT)
    IF (&DEPT *EQ 'MIS') DO /* NEXT COMMANDS QUALIFIED SO CL WILL COMPILE */
      RBTHALIB/RUNCMDRSF CMD(CALL APLLIB/CLP285S3 ('C' 'N' &USRPRF &CPYUSR &USRNME &GRPPRF &ACGCDEF &USROQN &USROQL)) +
                         SERVER(PROD3)
      MONMSG (CPF0000 RSF0000)
      RBTHALIB/RUNCMDRSF CMD(CALL APLLIB/CLP285S2 ('C' 'N' &USRPRF &CPYUSR &USRNME &GRPPRF &ACGCDEF &USROQN &USROQL)) +
                         SERVER(PROD2)
      MONMSG (CPF0000 RSF0000)
    ENDDO
  ENDDO

  /* ATTEMP TO CREATE AN OUTPUT QUEUE FOR THE USER PROFILE IN QGPL. THIS IS USED BY THE FASTFAX MONITOR */
  CRTOUTQ OUTQ(QGPL/&USRPRF)
  MONMSG CPF0000

  /* ATTEMP TO SETUP/CHANGE THE DIRECTORY ENTRY */
  CHGVAR     VAR(&USER8) VALUE(&USRPRF)
  CHGDIRE    USRID(&USER8 FABRICUT)
  MONMSG     MSGID(CPF9083) EXEC(DO)
    ADDDIRE  USRID(&USER8 FABRICUT) USRD('Added by USRMSTC2') USER(&USRPRF) SYSNAME(FABRICUT)
    MONMSG     MSGID(CPF0000)
  ENDDO

  /* ADD THE SMTP USER AND DOMAIN TO THE DIRECTORY ENTRY */
  IF (&SMTPUSR *NE ' ' & &SMTPDMN *NE ' ') (DO)
    CHGDIRE USRID(&USER8 FABRICUT) USRDFNFLD((SMTPAUSRID SMTP &SMTPUSR) (SMTPDMN SMTP &SMTPDMN))
    MONMSG     MSGID(CPF0000)
  ENDDO

ENDPGM
