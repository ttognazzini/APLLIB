/* Performace Logger - Memory Pool Log */

Create or Replace Table APLLIB.memory_pool_info_log for System Name PRLMPL (
  active_row                     for Column ACVROW    char(1) Not Null Default '1',
  memory_poll_info_log_id        for Column PrlMplIdn bigint Not Null
                                 Generated Always as Identity (Start With 1 Increment by 1),
  system_statistic_log_id        for Column prlSstIdn bigint,
  system_pool_id                 for column polIdn    decimal(3,0),
  pool_name                      for column polNme    varchar(10),
  current_size                   for column curSiz    decimal(20,2),
  reserved_size                  for column rsvSiz    decimal(10,2),
  defined_size                   for column defSiz    decimal(20,2),
  maximum_active_threads         for column maxThr    int,
  current_threads                for column curThr    int,
  current_ineligible_threads     for column curIth    int,
  subsystem_library_name         for column sbsNme    varchar(10),
  subsystem_name                 for column sbsLib    varchar(10),
  description                    for column polDes    varchar(50),
  paging_option                  for column pagOpt    varchar(10),
  elapsed_time                   for column elpTim    int,
  elapsed_database_faults        for column elpDbf    decimal(10,1),
  elapsed_non_database_faults    for column elpNbf    decimal(10,1),
  elapsed_total_faults           for column elpTfl    decimal(10,1),
  elapsed_database_pages         for column elpDbp    decimal(10,1),
  elapsed_non_database_pages     for column elpNbp    decimal(10,1),
  elapsed_active_to_wait         for column elpAcw    decimal(10,1),
  elapsed_wait_to_ineligible     for column elpInw    decimal(10,1),
  elapsed_active_to_ineligible   for column elpati    decimal(10,1),
  tuning_priority                for column tunPri    decimal(8,0),
  tuning_minimum_size            for column tunMns    decimal(10,2),
  tuning_maximum_size            for column tunMxs    decimal(10,2),
  tuning_minimum_faults          for column tunMnf    decimal(10,2),
  tuning_maximum_faults          for column tunMxf    decimal(10,2),
  tuning_thread_faults           for column tunThf    decimal(10,2),
  tuning_minimum_activity        for column tunMna    decimal(10,2),
  tuning_maximum_activity        for column tunMxa    decimal(10,2),
  create_time_stamp              for Column crtDtm    timestamp Not Null Default CURRENT_TIMESTAMP,
  create_user                    for Column crtUsr    char(18) Not Null Default USER,
  create_job                     for Column crtJob    char(28) Not Null With Default,
  create_program                 for Column crtPgm    char(10) Not Null With Default,
  maintenance_time_stamp         for Column mntDtm    timestamp Not Null Default CURRENT_TIMESTAMP,
  maintenance_user               for Column mntUsr    char(18) Not Null Default USER,
  maintenance_job                for Column mntJob    char(28) Not Null With Default,
  maintenance_program            for Column mntPgm    char(10) Not Null With Default
);

Label on Table PRLMPL is 'Performace Logger - Memory Pool Log';

Comment on Table PRLMPL is
'This table is used to log memory pool statistics. It is populated in program PRLLOGB1. The data is intented to be used
to see how the system memory is being used. This data can assist with memory pool configuration and to determine if the
system has enough memory.'
;


Label on Column APLLIB.PRLMPL (
  acvRow     is 'Active              Row',
  prlMplIdn  is 'Memory pool         Info Log            Id',
  polIdn     is 'System              Pool                Td',
  polNme     is 'Pool                Name',
  curSiz     is 'Current             Size',
  rsvSiz     is 'Reserved            Size',
  defSiz     is 'Defined             Size',
  maxThr     is 'Maximum             Active              Threads',
  curThr     is 'Current             Threads',
  curIth     is 'Current             Ineligible threads',
  sbsNme     is 'Subsystem           Library name',
  sbsLib     is 'Subsystem           Name',
  polDes     is 'Memory              Pool                Description',
  pagOpt     is 'Paging              Option',
  elpTim     is 'Elapsed             Time',
  elpDbf     is 'Elapsed             Database            Faults',
  elpNbf     is 'Elapsed             Non Database        Faults',
  elpTfl     is 'Elapsed             Total               Faults',
  elpDbp     is 'Elapsed             Database            Pages',
  elpNbp     is 'Elapsed             Non Database        Pages',
  elpAcw     is 'Elapsed             Active              To Wait',
  elpInw     is 'Elapsed             Wait to             Ineligible',
  elpati     is 'Elapsed             Active to           Ineligible',
  tunPri     is 'Tuning              Priority',
  tunMns     is 'Tuning              Minimum             Size',
  tunMxs     is 'Tuning              Maximum             Size',
  tunMnf     is 'Tuning              Minimum             Faults',
  tunMxf     is 'Tuning              Maximum             Faults',
  tunThf     is 'Tuning              Thread              Faults',
  tunMna     is 'Tuning              Minimum             Activity',
  tunMxa     is 'Tuning              Maximum             Activity',
  crtDtm     is 'Create              Timestamp',
  crtUsr     is 'Create              User',
  crtJob     is 'create              Job',
  crtPgm     is 'create              Program',
  mntDtm     is 'maintenance         Timestamp',
  mntUsr     is 'maintenance         User',
  mntJob     is 'maintenance         Job',
  mntPgm     is 'maintenance         Program'
);

Label on Column APLLIB.PRLMPL (
  ACVROW     text is 'Active Row',
  prlMplIdn  text is 'Memory Pool Info Log Id',
  polIdn     text is 'System Pool Id',
  polNme     text is 'Pool Name',
  curSiz     text is 'Current Size',
  rsvSiz     text is 'Reserved Size',
  defSiz     text is 'Defined Size',
  maxThr     text is 'Maximum Active Threads',
  curThr     text is 'Current Threads',
  curIth     text is 'Current Ineligible Threads',
  sbsNme     text is 'Subsystem Library Name',
  sbsLib     text is 'Subsystem Name',
  polDes     text is 'Description',
  pagOpt     text is 'Paging option',
  elpTim     text is 'Elapsed Time',
  elpDbf     text is 'Elapsed Database Faults',
  elpNbf     text is 'Elapsed Non database Faults',
  elpTfl     text is 'Elapsed Total Faults',
  elpDbp     text is 'Elapsed Database Pages',
  elpNbp     text is 'Elapsed Non Database Pages',
  elpAcw     text is 'Elapsed Active to Wait',
  elpInw     text is 'Elapsed Wait to Ineligible',
  elpati     text is 'Elapsed Active to Ineligible',
  tunPri     text is 'Tuning Priority',
  tunMns     text is 'Tuning Minimum Size',
  tunMxs     text is 'Tuning Maximum Size',
  tunMnf     text is 'Tuning Minimum Faults',
  tunMxf     text is 'Tuning Maximum Faults',
  tunThf     text is 'Tuning Thread Faults',
  tunMna     text is 'Tuning Minimum Activity',
  tunMxa     text is 'Tuning Maximum Activity',
  crtDtm     text is 'Create Date/Time (Time stamp)',
  crtUsr     text is 'Create User',
  crtJob     text is 'Create Job',
  crtPgm     text is 'Create Program',
  mntDtm     text is 'Maintenance Date',
  mntUsr     text is 'Maintenance User',
  mntJob     text is 'Maintenance Job',
  mntPgm     text is 'Maintenance Program'
);
