/* User Master Maintenance - Reset Password */

/****** COMPILE AS QSECOFR OR CHANGE THE OWNER ******/
/* CHGPGM PGM(USRMSTC4) USRPRF(*OWNER) USEADPAUT(*YES)     */
/* CHGOBJOWN OBJ(USRMSTC4) OBJTYPE(*PGM)  NEWOWN(QSECOFR)  */

PGM (&USRPRF &MESSAGE)

  DCL &USRPRF *CHAR 10
  DCL &MESSAGE *CHAR 100

  /* WORK VARIABLES */
  DCL &USRCLS  *CHAR 10

  /* MAKE SUER THE USER IT CLASS *USER. THIS PROGRAM HAS TO RESTRICT PEOPLE FROM  +
     CHANGING THE PASSWORD ON SECURITY ACCOUTNS AND SUCH. */
  RTVUSRPRF USRPRF(&USRPRF) USRCLS(&USRCLS)
  IF (&USRCLS *NE '*USER') (DO)
    CHGVAR &MESSAGE ('Error - you cannot reset the password of' *BCAT &USRCLS *BCAT 'users.')
    RETURN
  ENDDO

  /* THE USERS PASSWORD TO THIER PROFILE */
  CHGUSRPRF USRPRF(&USRPRF) PASSWORD(&USRPRF)
  MONMSG CPF0000 EXEC(DO)
    CHGVAR &MESSAGE ('Error occurred, check the job log.')
    RETURN
  ENDDO

  CHGVAR &MESSAGE ('Password reset.')
  RETURN

ENDPGM
