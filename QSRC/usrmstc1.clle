/* User Master Maintenance - Get User Profile details */

/****** COMPILE AS QSECOFR OR CHANGE THE OWNER ******/
/* CHGPGM PGM(USRMSTC1) USRPRF(*OWNER) USEADPAUT(*YES)     */
/* CHGOBJOWN OBJ(USRMSTC1) OBJTYPE(*PGM)  NEWOWN(QSECOFR)  */

PGM (&USRPRF &ACGCDE &USRTXT &USROQN &USROQL &GRPPRF &USRSTS &USRCLS)

  DCL &USRPRF *CHAR 10
  DCL &ACGCDE *CHAR 6
  DCL &USRTXT *CHAR 50
  DCL &USROQN *CHAR 10
  DCL &USROQL *CHAR 10
  DCL &GRPPRF *CHAR 10
  DCL &ACGCDEF *CHAR 15
  DCL &USRSTS *CHAR 10
  DCL &USRSTS12 *CHAR 12
  DCL &USRCLS *CHAR 10

  RTVUSRPRF  USRPRF(&USRPRF) GRPPRF(&GRPPRF) ACGCDE(&ACGCDEF) +
             OUTQ(&USROQN) OUTQLIB(&USROQL) TEXT(&USRTXT) STATUS(&USRSTS12) USRCLS(&USRCLS)
  MONMSG     (CPF0000) EXEC(DO)
    CHGVAR &ACGCDE ' '
    CHGVAR &USRTXT ' '
    CHGVAR &USROQN ' '
    CHGVAR &USROQL ' '
    CHGVAR &GRPPRF ' '
    CHGVAR &USRSTS ' '
    CHGVAR &USRCLS ' '
    GOTO SKIP
  ENDDO
  CHGVAR &ACGCDE &ACGCDEF
  CHGVAR &USRSTS &USRSTS12
  SKIP:

ENDPGM
