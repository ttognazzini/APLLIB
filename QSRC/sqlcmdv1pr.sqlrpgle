Dcl-S val Char(1000) dim(900) based(myPointer);
Dcl-S myPointer pointer Inz(%addr(MYDS));

Dcl-S nulls int(5) dim(900);

// define SQL data codes for field types, through V7R1
Dcl-Ds SQLCodes;
  SqlDataCodesl char(140)
    Inz('-972 +
         -924 +
         -920 +
         -916 +
         -904 +
         -400 +
         -360 +
         -350 +
         -96  +
         -95  +
         -3   +
         -2   +
         1    +
         2    +
         3    +
         4    +
         5    +
         6    +
         7    +
         8    +
         9    +
         12   +
         25   +
         30   +
         40   +
         50   +
         70   +
         137  ');
  SqlDataCodes Char(5) dim(28) overlay(SqlDataCodesL);
  SqlDataTypesL char(840)
    Inz('Result Set                    +
         DBCLOB File Reference Variable+
         CLOB File Reference Variable  +
         BLOB File Reference Variable  +
         ROWID                         +
         C nul terminated GRAPHIC      +
         DECFLOAT                      +
         DBCLOB                        +
         VARGRAPHIC                    +
         GRAPHIC                       +
         VARBINARY                     +
         BINARY                        +
         CHARACTER                     +
         NUMERIC                       +
         DECIMAL                       +
         Integer                       +
         SMALLINT                      +
         FLOAT                         +
         REAL                          +
         DOUBLE                        +
         DATE/TIME/TIMESTAMP           +
         VARCHAR                       +
         BIGINT                        +
         BLOB                          +
         CLOB                          +
         ARRAY                         +
         DATALINK                      +
         XML                           ');
  SqlDataTypes Char(30) dim(28) overlay(SqlDataTypesL);
End-Ds;


// parameter arrays/data structures
Dcl-Ds emlsDs Template Qualified;
  EMLCNTTM int(5);
  EMTM Char(50) dim(50);
End-Ds;
Dcl-S psEMLCNT int(5);
Dcl-S psEM Char(50) dim(50);
Dcl-Ds messDs Template Qualified;
  count int(5);
  message Char(5000);
  type Char(10);
End-Ds;
Dcl-S messageType Char(10);
Dcl-Ds objects dim(64) Qualified;
  element int(5);
  name Char(128);
  type Char(10);
End-Ds;
Dcl-Ds objectsDs Qualified Template;
  count int(5) pos(1);
  Data char(10000) pos(3);
End-Ds;
Dcl-Ds vr dim(10) Qualified;
  element int(5);
  var Char(10);
  Value Char(30);
End-Ds;
Dcl-Ds vrInDs Template Qualified;
  count int(5) pos(1);
  data Char(600) pos(3);
End-Ds;
Dcl-Ds outQDS Template Qualified;
  OUTQ Char(10);
  OQLB Char(10);
End-Ds;
Dcl-Ds outFDS Template Qualified;
  OUTF Char(10);
  OUTL Char(10);
End-Ds;
Dcl-Ds qryDfnDS Template Qualified;
  file Char(10);
  library Char(10);
End-Ds;
Dcl-Ds queries dim(300) Qualified;
  sql Char(5000);
  tab Char(32);
  title1 Char(80);
  title2 Char(80);
  title3 Char(80);
  title4 Char(80);
  title5 Char(80);
End-Ds;
Dcl-Ds queriesDs Qualified Template;
  count int(5) pos(1);
  Data char(1630600) pos(3);
End-Ds;


// SQL Command CPP (SQLCMDD1)
// Program Entry Parameters
Dcl-Pr SQLCDMD1 EXTPGM('SQLCMDD1');
  psName Char(5000);
  psActn Char(10);
  psUser Char(10);
  psQryDfnDs likeDs(qryDfnDS);
  psEmls likeDs(emlsDs);
  psFile Char(123);
  psType Char(5);
  psSheet Char(32);
  psTitle1 Char(80);
  psTitle2 Char(80);
  psTitle3 Char(80);
  psTitle4 Char(80);
  psTitle5 Char(80);
  psSubject Char(128);
  psMess likeDs(messDs);
  psObjects likeDs(objectsDs);
  psInVr Char(4);
  psRpId Char(10);
  psIfsFl Char(123);
  psIfsF Char(123);
  psIfsT Char(5);
  psOutQ likeDs(outQDS);
  psCopy packed(3);
  psHold Char(4);
  psSave Char(4);
  psUsDt Char(10);
  psFrWd packed(3);
  psFrLn packed(3);
  psPInVr Char(4);
  psPInQy Char(4);
  psPName Char(10);
  psOutF likeDs(outFDS);
  psVrIn LikeDs(vrInDs);
  psQueries likeDs(queriesDs);
End-Pr;


// Print SQL Statment program
Dcl-Pr SQLCMDB1 extpgm('SQLCMDB1');
  #$SQLstatment varchar(32000) const;
  #$variablesDs Char(500) const;
  #$outq Char(10) const;
  #$outQLibrary Char(10) const;
  #$copy packed(3) const;
  #$hold Char(5) const;
  #$save Char(5) const;
  #$usrdta Char(10) const;
  #$formLength packed(3) const;
  #$formWidth packed(3) const;
  #$includeVariable Char(4) const;
  #$includeQuery Char(4) const;
  #$title1 Char(80) const;
  #$title2 Char(80) const;
  #$title3 Char(80) const;
  #$title4 Char(80) const;
  #$title5 Char(80) const;
  #$programName Char(10) const;
  #$queries likeDs(queries) dim(300) options(*nopass);
End-Pr;


// Build JSON from SQL statement EMLSQLB3
Dcl-Pr BuildJson ExtPgm('EMLSQLB3');
  SQLCmd Char(5000);
  file Char(128);
  empty Char(4);
  readable Char(4);
  useText Char(4);
  title1 Char(80);
  title2 Char(80);
  title3 Char(80);
  title4 Char(80);
  title5 Char(80);
  queries likeDs(queries) dim(300);
End-Pr;


// Build PC File from SQL statement EMLSQLB2
Dcl-Pr BuildPCFile ExtPgm('EMLSQLB2');
  SQLCmd Char(5000);
  file Char(128);
  fileType Char(5);
  empty Char(4);
  useText Char(4);
  sheet Char(32);
  title1 Char(80);
  title2 Char(80);
  title3 Char(80);
  title4 Char(80);
  title5 Char(80);
  queries likeDs(queries) dim(300);
End-Pr;


// Used to see if an object exists and if we have access to it
Dcl-Pr access int(10) extproc('access');
  *n pointer Value options(*string); // Path
  *n int(10) Value; // amode
End-Pr;
// Access mode flags for access()
Dcl-C F_OK 0; // File Exists

// Display SQL Results
Dcl-Pr SQLCMDD2 ExtPgm('SQLCMDD2');
  #$sqlstm varchar(32000) const;
End-Pr;

// Get emails for a report distribution queue
// Parameters
//  1. Pass in the report distribution queue to retrieve the emails for
//  2. Variable to receive the list of email addresses
Dcl-Pr GetEmailsFromRPT ExtPgm('SYS242');
  distQ Char(10);
  distEmls Char(2048);
End-Pr;

// The jobs default output queue
Dcl-Pr GetOutQ ExtPgm('SQLCMDC1');
  outQ Char(10);
  outQLib Char(10);
End-Pr;

// Variables Data Structure
// variable are saved and passed as a 500 character constant, this DS is used
// to overlay the variables field to split out individual fields and create arrays
Dcl-Ds VarDs;
  VRNAME01 Char(10) pos(1);
  VRTYPE01 Char(1)  pos(11);
  VRDFT01  Char(30) pos(21);
  VRNAME02 Char(10) pos(51);
  VRTYPE02 Char(1)  pos(61);
  VRDFT02  Char(30) pos(71);
  VRNAME03 Char(10) pos(101);
  VRTYPE03 Char(1)  pos(111);
  VRDFT03  Char(30) pos(121);
  VRNAME04 Char(10) pos(151);
  VRTYPE04 Char(1)  pos(161);
  VRDFT04  Char(30) pos(171);
  VRNAME05 Char(10) pos(201);
  VRTYPE05 Char(1)  pos(211);
  VRDFT05  Char(30) pos(221);
  VRNAME06 Char(10) pos(251);
  VRTYPE06 Char(1)  pos(261);
  VRDFT06  Char(30) pos(271);
  VRNAME07 Char(10) pos(301);
  VRTYPE07 Char(1)  pos(311);
  VRDFT07  Char(30) pos(321);
  VRNAME08 Char(10) pos(351);
  VRTYPE08 Char(1)  pos(361);
  VRDFT08  Char(30) pos(371);
  VRNAME09 Char(10) pos(401);
  VRTYPE09 Char(1)  pos(411);
  VRDFT09  Char(30) pos(421);
  VRNAME10 Char(10) pos(451);
  VRTYPE10 Char(1)  pos(461);
  VRDFT10  Char(30) pos(471);
  VARS Char(50) dim(10) pos(1);
  VRNAME Char(10) overlay(vars);
  VRTYPE Char(1) overlay(vars:*next);
  VRDEC Char(1) overlay(vars:*next);
  VRLEN Char(3) overlay(vars:*next);
  VRWILD Char(1) overlay(vars:*next);
  VRLAST Char(1) overlay(vars:*next);
  VRALBL Char(1) overlay(vars:*next);
  VRRES Char(2) overlay(vars:*next);
  VRDFT Char(30) overlay(vars:*next);
End-Ds;


// The following DS contains the words to break on and the action to perform when found
// Action are:
//  1. break before Y or N
//  2. break after Y or N
//  3. New Indent Level Y/N
//  4. Indent Before, No, Increase, Decrease
//  5. Indent After, No, Increase, Decrease
Dcl-Ds #$FormatSQLKeywordDs Qualified Template;
  index zoned(2);
  word char(30);
  breakBefore char(1);
  breakAfter char(1);
  newIndentLevel char(1);
  indentBefore char(1);
  indentAfter char(1);
  length zoned(2);
  returnToIndentLevel char(30);
End-Ds;
Dcl-Ds #$FormatSQLds Qualified;
  keywordValues Char(2070) Inz(
    '01SELECT                        YYYNI06                              +
     02CASE                          YYNNI04                              +
     03WHEN                          YNNNI04                              +
     04ELSE                          YNNNN04                              +
     05END                           YNNDN03                              +
     06,                             NYNNN01                              +
     07FROM                          YNNNY04SELECT                        +
     08JOIN                          YNNNY04SELECT                        +
     09INNER JOIN                    YNNNN10SELECT                        +
     10LEFT JOIN                     YNNNN09SELECT                        +
     11LEFT OUTER JOIN               YNNNN15SELECT                        +
     12RIGHT OUTER JOIN              YNNNN16SELECT                        +
     13RIGHT JOIN                    YNNNN10SELECT                        +
     14EXCEPTION JOIN                YNNNN14SELECT                        +
     15CROSS JOIN                    YNNNN10SELECT                        +
     16FULL JOIN                     YNNNN09SELECT                        +
     17FULL OUTER JOIN               YNNNN15SELECT                        +
     18OUTER JOIN                    YNNNN10SELECT                        +
     19WHERE                         YNNNN05SELECT                        +
     20GROUP BY                      YNNNN08SELECT                        +
     21GROUPING SETS                 YNNIN13                              +
     22(                             YYYII01                              +
     23)                             YYNND01(                             +
     24ORDER BY                      YNNNI13SELECT                        +
     25HAVING                        YNNIN08                              +
     26WITH                          YNNNN06                              +
     27AND                           YNNNN03                              +
     28OR                            YNNNN02                              +
     29FETCH                         YNNNI05SELECT                        +
     30ON                            YNNIN02                              ');
  keyword Dim(30) Likeds(#$FormatSQLKeywordDs) overlay(keywordValues);
  keywordCount int(5) Inz(30);
End-Ds;

Dcl-Ds #$SQLColumns Qualified Template;
  count int(5);
  headerWidth int(10); // for printing
  headers Char(20000) Inz(' '); // for printing
  ruler Char(20000) Inz(' '); // for printing
  Dcl-Ds col dim(900);
    name varchar(128);
    type varchar(128);
    Text varchar(50);
    len int(10);
    dec int(10);
    scale int(10);
    nullable int(10);
    ccsid int(10);
    colWidth int(10); // width of column for printing
    offset int(10); // column offset for printing
  End-Ds;
End-Ds;


// #$PreviousWord - Returns the previous word in a string
Dcl-Pr #$PreviousWord Char(10);
  string Varchar(500) const;
  position packed(3) Value;
End-Pr;


// Build lines array from a passed sql statement
Dcl-Pr #$FormatSQL Char(250) Dim(1000);
  SQL Varchar(32000) const;
  psLineLength packed(3) Value options(*nopass);
End-Pr;


// build columns array
Dcl-Pr #$SQLGetColumns likeDs(#$SQLColumns);
  SQL Varchar(32000) const;
End-Pr;


