Create or Replace Trigger APLLIB.DCTFLDTRG
before Insert or Update on APLLIB.DCTFLD
Referencing new row as n old row as o
for each row mode db2row

Begin
  /* On create set the crtXXX values */
  If Inserting Then
    set n.create_time_stamp = current timestamp,
        n.create_user = user,
        n.create_job = job_name,
        n.create_program = APLLIB.current_program();
  End If ;


  /* On create, or update and a field changes, set the mntXXX values */
  If inserting or
     (updating and (
        n.active_row <> o.active_row
       or n.dictionary_field_id <> o.dictionary_field_id
       or n.dictionary_name <> o.dictionary_name
       or n.field_name <> o.field_name
       or n.field_name_sql <> o.field_name_sql
       or n.description <> o.description
       or n.field_ <> o.field_
       or n.field_length <> o.field_length
       or n.field_scale <> o.field_scale
       or n.field_allocation <> o.field_allocation
       or n.project_number <> o.project_number
       or n.column_text <> o.column_text
       or n.column_heading <> o.column_heading
       or n.processed_flag <> o.processed_flag
       or n.field_prompt_text <> o.field_prompt_text
       or n.allow_null <> o.allow_null
       or n.default_value <> o.default_value
       or n.field_enumerated <> o.field_enumerated
  )) Then
    set n.maintenance_time_stamp = current timestamp,
        n.maintenance_user = user,
        n.maintenance_job = job_name,
        n.maintenance_program = APLLIB.current_program();
  End If;

  /* Add all audited columns */

  /* Trim all varchar columns */

End
