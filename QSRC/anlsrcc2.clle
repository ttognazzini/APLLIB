/*********************************************************************/
/* Program : ANLSRCC2                                                */
/* Function: Sub-Program for ANLSRCF command                         */
/* Author  : Werner Noll                                             */
/* Remarks : This is free software.                                  */
/*           You can redistribute it and/or modify it.               */
/*           The only restriction is that you may not distribute     */
/*           it for the purposes of monetary gain.                   */
/*           We do not garantee for the expected functionalties.     */
/*           The use of this software is always at your own risk.    */
/*           All comments or reuqests for enhancements are           */
/*           welcome. My email: werner.noll@gefis.com.               */
/*********************************************************************/
             PGM        PARM(&SRCFLIB &STR01 &STR02 &STR03 +
                          &STR04 &STR05 &STR06 &STR07 &STR08 &STR09 +
                          &STR10 &CMATCH)
             DCLPRCOPT  ALWRTVSRC(*YES) DFTACTGRP(*NO) ACTGRP(*CALLER)
             DCL        VAR(&SRCFLIB) TYPE(*CHAR) LEN(20)
             DCL        VAR(&SRCF) TYPE(*CHAR) LEN(10)
             DCL        VAR(&SRCLIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&STR01) TYPE(*CHAR) LEN(10)
             DCL        VAR(&STR02) TYPE(*CHAR) LEN(10)
             DCL        VAR(&STR03) TYPE(*CHAR) LEN(10)
             DCL        VAR(&STR04) TYPE(*CHAR) LEN(10)
             DCL        VAR(&STR05) TYPE(*CHAR) LEN(10)
             DCL        VAR(&STR06) TYPE(*CHAR) LEN(10)
             DCL        VAR(&STR07) TYPE(*CHAR) LEN(10)
             DCL        VAR(&STR08) TYPE(*CHAR) LEN(10)
             DCL        VAR(&STR09) TYPE(*CHAR) LEN(10)
             DCL        VAR(&STR10) TYPE(*CHAR) LEN(10)
             DCL        VAR(&STR10) TYPE(*CHAR) LEN(10)
             DCL        VAR(&CMATCH) TYPE(*CHAR) LEN(1)
             DCL        VAR(&MSGID) TYPE(*CHAR) LEN(7)
             DCL        VAR(&MSGDTA) TYPE(*CHAR) LEN(132)
             DCL        VAR(&MSGF)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&MBR)    TYPE(*CHAR) LEN(10)

             DCL        VAR(&USRSPC) TYPE(*CHAR) LEN(20) +
                          VALUE('ANLSRCF1  QTEMP     ')
             DCL        VAR(&EXTATTR) TYPE(*CHAR) LEN(10)
             DCL        &USSIZE *CHAR 4  X'00000500'
             DCL        VAR(&USINIT) TYPE(*CHAR) LEN(1) VALUE(X'00')
             DCL        VAR(&USAUTH) TYPE(*CHAR) LEN(10) +
                          VALUE('*EXCLUDE')
             DCL        VAR(&USTEXT) TYPE(*CHAR) LEN(50) VALUE('For +
                          ANLSRCF command')
             DCL        VAR(&USREPL) TYPE(*CHAR) LEN(10) VALUE('*YES')
             DCL        VAR(&ERROR) TYPE(*CHAR) LEN(128) +
                          VALUE(X'0000008000000000')
             DCL        VAR(&FORMAT) TYPE(*CHAR) LEN(10)
             DCL        VAR(&OBJ) TYPE(*CHAR) LEN(20)
             DCL        VAR(&OBJTYP) TYPE(*CHAR) LEN(10)
             DCL        VAR(&STRPOS) TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&LEN) TYPE(*CHAR) LEN(4) VALUE(X'0000008C')
             DCL        VAR(&RCVV1) TYPE(*CHAR) LEN(140)
             DCL        VAR(&RCVV2) TYPE(*CHAR) LEN(1024)
             DCL        VAR(&COUNT) TYPE(*DEC) LEN(9 0) VALUE(0)
             DCL        VAR(&A4) TYPE(*CHAR) LEN(4)
/* Variables for Program QCLSCAN                                   */
             DCL        VAR(&GENERIC) TYPE(*LGL) VALUE('0')
             DCL        VAR(&#STRING)     TYPE(*CHAR) LEN(30)
             DCL        VAR(&#STRLEN)     TYPE(*DEC)  LEN(3 0)
             DCL        VAR(&#STRPOS)     TYPE(*DEC)  LEN(3 0)
             DCL        VAR(&#PATTERN)    TYPE(*CHAR) LEN(10)
             DCL        VAR(&#PATLEN)     TYPE(*DEC)  LEN(3 0)
             DCL        VAR(&#XLATE)      TYPE(*CHAR) LEN(1)
             DCL        VAR(&#TRIM)       TYPE(*CHAR) LEN(1)
             DCL        VAR(&#WILD)       TYPE(*CHAR) LEN(1)
             DCL        VAR(&#RESULT)     TYPE(*DEC)  LEN(3 0)
/*------------------------------------------------------------------*/
/* Global message monitor                                           */
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))
/*------------------------------------------------------------------*/

             CHGVAR     VAR(&SRCF) VALUE(%SST(&SRCFLIB 1 10))
             CHGVAR     VAR(&SRCLIB) VALUE(%SST(&SRCFLIB 11 10))

/* If SRCLIB a generic name or *ALLUSR                         */
/* Retrieve libraries                                          */

/*   Check if library is a generic name                        */
             IF         COND(&SRCLIB *NE '*ALLUSR') THEN(DO)
             CHGVAR     VAR(&#STRING) VALUE(&SRCLIB)
             CHGVAR     VAR(&#STRLEN) VALUE(10)
             CHGVAR     VAR(&#STRPOS) VALUE(1)
             CHGVAR     VAR(&#PATTERN) VALUE('*')
             CHGVAR     VAR(&#PATLEN) VALUE(1)
             CHGVAR     VAR(&#XLATE) VALUE('0')
             CHGVAR     VAR(&#TRIM) VALUE('1')
             CHGVAR     VAR(&#WILD) VALUE(' ')
             CALL       PGM(QCLSCAN) PARM(&#STRING &#STRLEN &#STRPOS +
                          &#PATTERN &#PATLEN &#XLATE &#TRIM &#WILD +
                          &#RESULT)
             IF         COND(&#RESULT *NE 0) THEN(DO)
             CHGVAR     VAR(&GENERIC) VALUE('1')
             ENDDO
             ENDDO

             IF         COND(&SRCLIB *EQ '*ALLUSR' *OR &GENERIC *EQ +
                          '1') THEN(DO)

/* Create UsrSpc    */
             CALL       PGM(QUSCRTUS) PARM(&USRSPC &EXTATTR &USSIZE +
                          &USINIT &USAUTH &USTEXT &USREPL &ERROR)

/* Fill UsrSpc  */
             CHGVAR     VAR(&FORMAT) VALUE('OBJL0100')
             CHGVAR     VAR(&OBJ)    VALUE(&SRCLIB *CAT 'QSYS')
             CHGVAR     VAR(&OBJTYP) VALUE('*LIB')
             CALL       PGM(QUSLOBJ) PARM(&USRSPC &FORMAT &OBJ +
                          &OBJTYP &ERROR)

/* Read head  */
             CALL       PGM(QUSRTVUS) PARM(&USRSPC &STRPOS &LEN +
                          &RCVV1 &ERROR)

/* Retrieve start position */
             CHGVAR     VAR(&STRPOS) VALUE(%SST(&RCVV1 125 4))
             CHGVAR     VAR(%BIN(&STRPOS)) VALUE(%BIN(&STRPOS) + 1)

             CHGVAR     VAR(&LEN) VALUE(%SST(&RCVV1 137 4))
             CHGVAR     VAR(&A4) VALUE(%SST(&RCVV1 133 4))
             CHGVAR     VAR(&COUNT) VALUE(%BIN(&A4))
             CHGVAR     VAR(&A4) VALUE(%SST(&RCVV1 137 4))
             CHGVAR     VAR(&RCVV2) VALUE(*BLANKS)

 LOOP:       IF         COND(&COUNT *LT 1) THEN(GOTO CMDLBL(ENDE))
/* Read positions */
             CALL       PGM(QUSRTVUS) PARM(&USRSPC &STRPOS &LEN +
                          &RCVV2 &ERROR)
/* Retrieve source files                                            */
             CHGVAR     VAR(&SRCLIB) VALUE(%SST(&RCVV2 1 10))
             CALL       PGM(ANLSRCC3) PARM(&SRCFLIB &STR01 &STR02 +
                          &STR03 &STR04 &STR05 &STR06 &STR07 &STR08 +
                          &STR09 &STR10 &CMATCH &SRCF &SRCLIB)

/* Calculate next position */
             CHGVAR     VAR(%BIN(&STRPOS)) VALUE(%BIN(&STRPOS) + +
                          %BIN(&A4))
             CHGVAR     VAR(&COUNT) VALUE(&COUNT - 1)
             GOTO       CMDLBL(LOOP)

/* Delete UsrSpc  */
 ENDE:       CALL       PGM(QUSDLTUS) PARM(&USRSPC &ERROR)
/* Close printerfile */
             CHGVAR     VAR(&MBR) VALUE('*END')
             CALL       PGM(ANLSRCB1) PARM(&SRCFLIB &STR01 &STR02 +
                          &STR03 &STR04 &STR05 &STR06 &STR07 &STR08 +
                          &STR09 &STR10 &CMATCH &SRCF &SRCLIB &MBR)
             GOTO       CMDLBL(EOP)
             ENDDO
/* If SRCLIB is a real library name                            */
             ELSE       CMD(DO)
/* Retrieve source files                                            */
             CALL       PGM(ANLSRCC3) PARM(&SRCFLIB &STR01 &STR02 +
                          &STR03 &STR04 &STR05 &STR06 &STR07 &STR08 +
                          &STR09 &STR10 &CMATCH &SRCF &SRCLIB)
/* Close printerfile */
             CHGVAR     VAR(&MBR) VALUE('*END')
             CALL       PGM(ANLSRCB1) PARM(&SRCFLIB &STR01 &STR02 +
                          &STR03 &STR04 &STR05 &STR06 &STR07 &STR08 +
                          &STR09 &STR10 &CMATCH &SRCF &SRCLIB &MBR)
             GOTO       CMDLBL(EOP)
             ENDDO
/*------------------------------------------------------------------*/
/* Error handling                                                   */
 ERROR:      RCVMSG     MSGDTA(&MSGDTA) MSGID(&MSGID) MSGF(&MSGF)
             SNDPGMMSG  MSGID(&MSGID) MSGF(&MSGF) MSGTYPE(*ESCAPE)
/*------------------------------------------------------------------*/
 EOP:        ENDPGM
