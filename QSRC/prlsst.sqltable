/* Performace Logger - System Statistics Log */

Create or Replace Table APLLIB.system_status_info_log for System Name PRLSST (
  active_row                                      for Column ACVROW    char(1) Not Null Default '1',
  system_statistic_log_id                         for Column prlSstIdn bigint Not Null
                                                  Generated Always as Identity (Start With 1 Increment by 1),
  total_jobs_in_system                            for column totJbs    int,
  maximum_jobs_in_system                          for column maxJbs    int,
  active_jobs_in_system                           for column actJbs    int,
  interactive_jobs_in_system                      for column intJbs    decimal (5,2),
  jobs_signed_on                                  for column jbsSin    int,
  jobs_disconnected                               for column jbsDis    int,
  jobs_suspended_by_sysreq                        for column jbsSps    int,
  jobs_suspended_by_group_job                     for column jbsSpg    int,
  jobs_print_waiting                              for column jbsPrw    int,
  batch_running                                   for column jsbBrn    int,
  batch_waiting_to_run                            for column jbsBwr    int,
  batch_ending                                    for column jbsEnd    int,
  batch_message_wait                              for column jbsMsw    int,
  batch_held_while_running                        for column jbsHdr    int,
  batch_held_on_jobq                              for column jbsHlj    int,
  batch_on_held_jobq                              for column jbsOhj    int,
  batch_on_unassigned_jobq                        for column jbsOuh    int,
  batch_print_waiting                             for column jbsBpw    int,
  elapsed_time                                    for column elpTme    int,
  elapsed_cpu_used                                for column elpCus    decimal(5,2),
  elapsed_cpu_shared                              for column elpCsh    decimal(5,2),
  elapsed_cpu_uncapped_capacity                   for column elpCuc    decimal(5,2),
  configured_cpus                                 for column cnfCpu    int,
  cpu_sharing_attribute                           for column cpuShr    varchar(8),
  current_cpu_capacity                            for column cpuCap    decimal(5,2),
  average_cpu_rate                                for column avgCrt    decimal(5,2),
  average_cpu_utilization                         for column avgCut    decimal(5,2),
  minimum_cpu_utilization                         for column minCut    decimal(5,2),
  maximum_cpu_utilization                         for column maxCut    decimal(5,2),
  sql_cpu_utilization                             for column sqlCut    decimal(5,2),
  main_storage_size                               for column stgSiz    bigint,
  system_asp_storage                              for column sysAsp    bigint,
  total_auxiliary_storage                         for column auxStg    bigint,
  system_asp_used                                 for column aspUsd    decimal(5,2),
  current_temporary_storage                       for column tmpStg    int,
  maximum_temporary_storage_used                  for column maxTst    int,
  permanent_address_rate                          for column prmAdr    decimal(6,3),
  temporary_address_rate                          for column tmpAdr    decimal(6,3),
  temporary_256mb_segments                        for column tmp256    decimal(5,2),
  temporary_4gb_segments                          for column tmp4gb    decimal(5,2),
  permanent_256mb_segments                        for column prm256    decimal(5,2),
  permanent_4gb_segments                          for column prm4gb    decimal(5,2),
  temporary_job_structures_available              for column tmpJsa    int,
  permanent_job_structures_available              for column prmJsa    int,
  total_job_table_entries                         for column totJen    int,
  available_job_table_entries                     for column avlJen    int,
  in_use_job_table_entries                        for column inuJte    int,
  active_job_table_entries                        for column actJte    int,
  jobq_job_table_entries                          for column jbqJte    int,
  outq_job_table_entries                          for column otqjte    int,
  joblog_pending_job_table_entries                for column jbpJte    int,
  host_name                                       for column hstNme    varchar(255),
  partition_id                                    for column prtIdn    int,
  number_of_partitions                            for column munPrt    int,
  active_threads_in_system                        for column actThr    int,
  restricted_state                                for column rstSts    varchar(3),
  partition_name                                  for column prtNme    varchar(255),
  partition_group_id                              for column prtGid    int,
  shared_processor_pool_id                        for column shrPpi    int,
  defined_memory                                  for column defMem    bigint,
  minimum_memory                                  for column minMem    bigint,
  maximum_memory                                  for column maxMem    bigint,
  memory_increment                                for column memInc    bigint,
  dedicated_processors                            for column dedPrc    varchar(3),
  physical_processors                             for column phyPrc    int,
  physical_processors_shared_pool                 for column pypShp    int,
  maximum_physical_processors                     for column maxPpr    int,
  defined_virtual_processors                      for column dftVpr    int,
  virtual_processors                              for column vrtPrc    int,
  minimum_virtual_processors                      for column minVpr    int,
  maximum_virtual_processors                      for column maxVpr    int,
  defined_processing_capacity                     for column dfnPcp    decimal(5,2),
  processing_capacity                             for column prcCap    decimal(5,2),
  unallocated_processing_capacity                 for column unaPcp    decimal(5,2),
  minimum_required_processing_capacity            for column mnrPcp    decimal(5,2),
  maximum_licensed_processing_capacity            for column mxlPcp    decimal(5,2),
  minimum_processing_capacity                     for column minPcp    decimal(5,2),
  maximum_processing_capacity                     for column maxPcp    decimal(5,2),
  processing_capacity_increment                   for column pcpInc    decimal(5,2),
  defined_interactive_capacity                    for column dfnIcp    decimal(5,2),
  interactive_capacity                            for column intCap    decimal(5,2),
  interactive_threshold                           for column intThh    decimal(5,2),
  unallocated_interactive_capacity                for column unaIcp    decimal(5,2),
  minimum_interactive_capacity                    for column minIcp    decimal(5,2),
  maximum_interactive_capacity                    for column macIcp    decimal(5,2),
  defined_variable_capacity_weight                for column dfvCwt    int,
  variable_capacity_weight                        for column varCwt    int,
  unallocated_variable_capacity_weight            for column uavCwt    int,
  hardware_multithreading                         for column hdwMlt    varchar(3),
  bound_hardware_threads                          for column bndHwt    varchar(3),
  threads_per_processor                           for column thrPpc    int,
  dispatch_latency                                for column disLat    decimal(20,0),
  dispatch_wheel_rotation_time                    for column disWrt    decimal(20,0),
  total_cpu_time                                  for column cpuTme    decimal(20,0),
  interactive_cpu_time                            for column intCtm    decimal(20,0),
  interactive_cpu_time_above_threshold            for column ictAth    decimal(20,0),
  unused_cpu_time_shared_pool                     for column uncTsp    decimal(20,0),
  machine_type                                    for column mchTyp    char(4),
  machine_model                                   for column mchMdl    char(4),
  serial_number                                   for column srnNbr    char(8),
  machine_serial_number                           for column mchSrn    char(8),
  attention_light                                 for column atnLgt    varchar(3),
  ipl_mode                                        for column iplMde    varchar(9),
  ipl_type                                        for column iplTyp    char(1),
  journal_recovery_count                          for column jrnRct    int,
  journal_cache_wait_time                         for column jrnCwt    int,
  job_schedule_status                             for column jbsSts    varchar(8),
  access_path_target_recovery_time                for column acpTrt    varchar(7),
  smapp_include_access_paths                      for column smiAcp    varchar(9),
  access_path_estimated_recovery_time             for column acpErt    int,
  access_path_estimated_ineligible_recovery_time  for column acpEir    int,
  smapp_disk_storage_used                         for column sdkSgu    bigint,
  power_enterprise_pool_processors                for column pwePpr    int,
  create_time_stamp                               for Column crtDtm    timestamp    Not Null Default CURRENT_TIMESTAMP,
  create_user                                     for Column crtUsr    char(18)     Not Null Default USER,
  create_job                                      for Column crtJob    char(28),
  create_program                                  for Column crtPgm    char(10),
  maintenance_time_stamp                          for Column mntDtm    timestamp    Not Null Default CURRENT_TIMESTAMP,
  maintenance_user                                for Column mntUsr    char(18)     Not Null Default USER,
  maintenance_job                                 for Column mntJob    char(28),
  maintenance_program                             for Column mntPgm    char(10)
);

Label on Table PRLSST is 'Performace Logger - System Statistics Log';

Comment on Table PRLSST is
'This table is used to log system statistics. It is populated in program PRLLOGB1. The data is intented to be used to se
e how the system resources are being used. This data can assist with system configuration and to determine if the system
 needs more resources.'
;


